# Copy to .env and fill in. .env must never be committed.

# The TimescaleDB that the Teltonika listener writes to.
#   Railway, same project -> ${{timescaledb.DATABASE_URL}}  (private network)
#   Railway, from outside -> DATABASE_PUBLIC_URL (*.proxy.rlwy.net:<port>)
DATABASE_URL=

# Required by every request when set. WITHOUT IT ANYONE WHO CAN REACH THE
# PORT CAN READ EVERY VEHICLE POSITION.   openssl rand -hex 24
API_KEY=

# Browser origins allowed to call the API, comma separated. Default * is fine
# while the key above is set; narrow it to your frontend's URL in production.
# API_CORS_ORIGINS=https://fleet.example.com

# auto (default) uses push notifications when the avl_records_notify trigger
# is installed (the listener's schema.sql does that) and polls otherwise.
# API_REALTIME=auto
# API_POLL_INTERVAL=2

# Railway injects PORT itself. Default 8000.
# PORT=8000
